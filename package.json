{
  "name": "dsh-desktop",
  "version": "0.1.1",
  "description": "DeepSeek Harness 桌面版 —— Electron 壳包装 dsh web 服务",
  "main": "main.js",
  "author": "dsh-desktop",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "copyright": "Copyright © 2026 DeepSeek Harness Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/afterPack.js",
    "files": [
      "main.js",
      "package.json",
      "assets/**/*",
      "settings/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/node",
        "to": "node"
      },
      {
        "from": "vendor/dsh",
        "to": "dsh"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness-Desktop-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DeepSeek-Harness-Desktop-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@*": true,
    "sharp@*": true
  }
}
